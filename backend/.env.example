# MongoDB Connection Settings
MONGO_URI=mongodb://localhost:27017
MONGO_DB=netriq_db

# Connection Pool Settings
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=100

# Data Retention
# Number of days to keep ephemeral flow/threat data before auto-deletion
THREAT_RETENTION_DAYS=7

# Firewall API Integration (Layer 1)
FIREWALL_ADAPTER_TYPE=noop  # Options: generic_rest, noop
FIREWALL_API_URL=https://firewall.local/api/v1
FIREWALL_API_KEY=secret_key

# Quarantine Integration (Layer 2)
QUARANTINE_MODE=noop # Options: active, noop
QUARANTINE_API_URL=https://sdn-controller.local/api/isolate
QUARANTINE_API_KEY=secret_key

# Sandbox Integration
SANDBOX_MODE=noop

# JWT Authentication
JWT_SECRET_KEY=super_secret_key_change_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Password Hashing & Security
PASSWORD_HASH_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
